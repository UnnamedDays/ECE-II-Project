    %addi 1, 0, 32;
    %store/vec4 v00000152646128B0_0, 0, 32;
    %jmp T_1.0;
T_1.1 ; for-loop exit label
    %load/vec4 v00000152646124F0_0;
    %cmpi/ne 8, 0, 32;
