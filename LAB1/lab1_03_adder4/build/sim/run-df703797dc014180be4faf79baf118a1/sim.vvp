S_00000264ADAA03A0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_00000264ADAA0780 .scope module, "tb_adder_4bit" "tb_adder_4bit" 3 3;
 .timescale -9 -12;
