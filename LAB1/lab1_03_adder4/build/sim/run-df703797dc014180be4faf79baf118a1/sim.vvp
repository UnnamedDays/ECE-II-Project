L_00000264ADAFF0D0 .part L_00000264ADAFE950, 0, 4;
L_00000264ADAFE8B0 .concat [ 4 1 0 0], v00000264ADAFF030_0, L_00000264B64E0088;
L_00000264ADAFF7B0 .concat [ 4 1 0 0], v00000264ADAFF2B0_0, L_00000264B64E00D0;
L_00000264ADAFE950 .arith/sum 5, L_00000264ADAFE8B0, L_00000264ADAFF7B0;
    .scope S_00000264ADAA0780;
T_0 ;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v00000264ADAFF170_0, 0, 32;
    %end;
    .thread T_0, $init;
    .scope S_00000264ADAA0780;
T_1 ;
    %vpi_call/w 3 20 "$dumpfile", "wave.vcd" {0 0 0};
    %vpi_call/w 3 20 "$dumpvars", 32'sb00000000000000000000000000000000, S_00000264ADAA0780 {0 0 0};
    %pushi/vec4 0, 0, 32;
    %store/vec4 v00000264ADAFF3F0_0, 0, 32;
T_1.0 ; Top of for-loop
    %load/vec4 v00000264ADAFF3F0_0;
    %cmpi/s 25, 0, 32;
	  %jmp/0xz T_1.1, 5;
    %load/vec4 v00000264ADAFF3F0_0;
    %pad/s 8;
    %split/vec4 4;
    %store/vec4 v00000264ADAFF2B0_0, 0, 4;
    %store/vec4 v00000264ADAFF030_0, 0, 4;
    %load/vec4 v00000264ADAFF3F0_0;
    %pushi/vec4 16, 0, 32;
    %div/s;
    %load/vec4 v00000264ADAFF3F0_0;
    %pushi/vec4 16, 0, 32;
    %mod/s;
    %add;
    %pad/s 5;
    %store/vec4 v00000264ADAFEE50_0, 0, 5;
    %delay 10000, 0;
    %load/vec4 v00000264ADAFF710_0;
    %load/vec4 v00000264ADAFF530_0;
    %concat/vec4; draw_concat_vec4
    %load/vec4 v00000264ADAFEE50_0;
    %cmp/ne;
    %jmp/0xz  T_1.3, 6;
    %load/vec4 v00000264ADAFF710_0;
    %load/vec4 v00000264ADAFF530_0;
    %concat/vec4; draw_concat_vec4
    %vpi_call/w 3 28 "$fatal", 32'sb00000000000000000000000000000001, "FAIL adder_4bit vector=%0d expected=%h, actual=%h", v00000264ADAFF3F0_0, v00000264ADAFEE50_0, S<0,vec4,u5> {1 0 0};
T_1.3 ;
    %load/vec4 v00000264ADAFF170_0;
    %addi 1, 0, 32;
    %store/vec4 v00000264ADAFF170_0, 0, 32;
T_1.2 ; for-loop step statement
    %load/vec4 v00000264ADAFF3F0_0;
    %addi 1, 0, 32;
    %store/vec4 v00000264ADAFF3F0_0, 0, 32;
    %jmp T_1.0;
T_1.1 ; for-loop exit label
    %load/vec4 v00000264ADAFF170_0;
    %cmpi/ne 256, 0, 32;
    %jmp/0xz  T_1.5, 4;
    %vpi_call/w 3 32 "$fatal", 32'sb00000000000000000000000000000001, "Incomplete test" {0 0 0};
T_1.5 ;
    %vpi_call/w 3 33 "$display", "LAB1_PASS adder_4bit cases=%0d", v00000264ADAFF170_0 {0 0 0};
    %vpi_call/w 3 34 "$finish" {0 0 0};
    %end;
    .thread T_1;
    .scope S_00000264ADAA0780;
T_2 ;
    %delay 100000000, 0;
    %vpi_call/w 3 37 "$fatal", 32'sb00000000000000000000000000000001, "Watchdog" {0 0 0};
    %end;
    .thread T_2;
