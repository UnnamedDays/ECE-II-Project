    .scope S_000001EB474DE410;
T_0 ;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v000001EB474E1110_0, 0, 32;
    %end;
    .thread T_0, $init;
    .scope S_000001EB474DE410;
T_1 ;
