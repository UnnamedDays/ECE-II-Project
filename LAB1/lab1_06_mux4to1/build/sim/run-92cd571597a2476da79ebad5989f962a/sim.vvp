    %cmp/ne;
    %jmp/0xz  T_1.3, 6;
    %vpi_call/w 3 23 "$fatal", 32'sb00000000000000000000000000000001, "FAIL mux_4x1 vector=%0d expected=%h actual=%h", v000001EB474EEF40_0, v000001EB474E11B0_0, v000001EB4753BE20_0 {0 0 0};
T_1.3 ;
    %load/vec4 v000001EB474E1110_0;
    %addi 1, 0, 32;
    %store/vec4 v000001EB474E1110_0, 0, 32;
T_1.2 ; for-loop step statement
    %load/vec4 v000001EB474EEF40_0;
    %addi 1, 0, 32;
    %store/vec4 v000001EB474EEF40_0, 0, 32;
    %jmp T_1.0;
T_1.1 ; for-loop exit label
    %load/vec4 v000001EB474E1110_0;
    %cmpi/ne 64, 0, 32;
    %jmp/0xz  T_1.5, 4;
    %vpi_call/w 3 30 "$fatal", 32'sb00000000000000000000000000000001, "Incomplete test" {0 0 0};
T_1.5 ;
