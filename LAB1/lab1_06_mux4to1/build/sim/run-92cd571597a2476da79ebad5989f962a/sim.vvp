    %pushi/vec4 0, 0, 32;
    %store/vec4 v000001EB474EEF40_0, 0, 32;
T_1.0 ; Top of for-loop
    %load/vec4 v000001EB474EEF40_0;
    %cmpi/s 64, 0, 32;
	  %jmp/0xz T_1.1, 5;
    %load/vec4 v000001EB474EEF40_0;
    %pad/s 6;
    %split/vec4 2;
    %store/vec4 v000001EB474EEFE0_0, 0, 2;
    %store/vec4 v000001EB474E1250_0, 0, 4;
    %load/vec4 v000001EB474EEF40_0;
    %pushi/vec4 4, 0, 32;
    %div/s;
    %pushi/vec4 3, 0, 32;
    %load/vec4 v000001EB474EEF40_0;
    %pushi/vec4 4, 0, 32;
    %mod/s;
    %sub;
    %ix/vec4 4;
    %shiftr 4;
    %pushi/vec4 1, 0, 32;
    %and;
    %pad/s 1;
    %store/vec4 v000001EB474E11B0_0, 0, 1;
    %delay 10000, 0;
    %load/vec4 v000001EB4753BE20_0;
