#! /c/Source/iverilog-install/bin/vvp
:ivl_version "14.0 (devel)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "C:\iverilog\lib\ivl\system.vpi";
:vpi_module "C:\iverilog\lib\ivl\vhdl_sys.vpi";
:vpi_module "C:\iverilog\lib\ivl\vhdl_textio.vpi";
:vpi_module "C:\iverilog\lib\ivl\v2005_math.vpi";
:vpi_module "C:\iverilog\lib\ivl\va_math.vpi";
:vpi_module "C:\iverilog\lib\ivl\v2009.vpi";
S_000001FAD99108B0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_000001FAD9910C90 .scope module, "tb_logic_gate_modern" "tb_logic_gate_modern" 3 3;
 .timescale -9 -12;
v000001FAD996D760_0 .var "a", 0 0;
v000001FAD996D580_0 .var "b", 0 0;
v000001FAD996D940_0 .var/i "checked", 31 0;
v000001FAD996DA80_0 .var "expected", 2 0;
v000001FAD996D4E0_0 .var/i "n", 31 0;
v000001FAD996DB20_0 .net "x", 0 0, L_000001FAD99258C0;  1 drivers
v000001FAD996D3A0_0 .net "y", 0 0, L_000001FAD9925770;  1 drivers
v000001FAD996DEE0_0 .net "z", 0 0, L_000001FAD9925620;  1 drivers
S_000001FAD99134E0 .scope module, "dut" "logic_gate" 3 5, 4 4 0, S_000001FAD9910C90;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "x";
    .port_info 3 /OUTPUT 1 "y";
    .port_info 4 /OUTPUT 1 "z";
L_000001FAD99258C0 .functor AND 1, v000001FAD996D760_0, v000001FAD996D580_0, C4<1>, C4<1>;
L_000001FAD9925770 .functor OR 1, v000001FAD996D760_0, v000001FAD996D580_0, C4<0>, C4<0>;
L_000001FAD9925620 .functor XOR 1, v000001FAD996D760_0, v000001FAD996D580_0, C4<0>, C4<0>;
v000001FAD9913670_0 .net "a", 0 0, v000001FAD996D760_0;  1 drivers
v000001FAD98E4E50_0 .net "b", 0 0, v000001FAD996D580_0;  1 drivers
v000001FAD9921C50_0 .net "x", 0 0, L_000001FAD99258C0;  alias, 1 drivers
v000001FAD9913710_0 .net "y", 0 0, L_000001FAD9925770;  alias, 1 drivers
v000001FAD99137B0_0 .net "z", 0 0, L_000001FAD9925620;  alias, 1 drivers
    .scope S_000001FAD9910C90;
T_0 ;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v000001FAD996D940_0, 0, 32;
    %end;
    .thread T_0, $init;
    .scope S_000001FAD9910C90;
T_1 ;
    %vpi_call/w 3 9 "$dumpfile", "wave.vcd" {0 0 0};
    %vpi_call/w 3 9 "$dumpvars", 32'sb00000000000000000000000000000000, S_000001FAD9910C90 {0 0 0};
    %pushi/vec4 0, 0, 32;
    %store/vec4 v000001FAD996D4E0_0, 0, 32;
T_1.0 ; Top of for-loop
    %load/vec4 v000001FAD996D4E0_0;
    %cmpi/s 4, 0, 32;
	  %jmp/0xz T_1.1, 5;
    %load/vec4 v000001FAD996D4E0_0;
    %pad/s 2;
    %split/vec4 1;
    %store/vec4 v000001FAD996D580_0, 0, 1;
    %store/vec4 v000001FAD996D760_0, 0, 1;
    %load/vec4 v000001FAD996D760_0;
    %load/vec4 v000001FAD996D580_0;
    %and;
    %load/vec4 v000001FAD996D760_0;
    %load/vec4 v000001FAD996D580_0;
    %or;
    %concat/vec4; draw_concat_vec4
    %load/vec4 v000001FAD996D760_0;
    %load/vec4 v000001FAD996D580_0;
    %xor;
    %concat/vec4; draw_concat_vec4
    %store/vec4 v000001FAD996DA80_0, 0, 3;
    %delay 10000, 0;
    %load/vec4 v000001FAD996DB20_0;
    %load/vec4 v000001FAD996D3A0_0;
    %concat/vec4; draw_concat_vec4
    %load/vec4 v000001FAD996DEE0_0;
    %concat/vec4; draw_concat_vec4
    %load/vec4 v000001FAD996DA80_0;
    %cmp/ne;
    %jmp/0xz  T_1.3, 6;
    %load/vec4 v000001FAD996DB20_0;
    %load/vec4 v000001FAD996D3A0_0;
    %concat/vec4; draw_concat_vec4
    %load/vec4 v000001FAD996DEE0_0;
    %concat/vec4; draw_concat_vec4
    %vpi_call/w 3 17 "$fatal", 32'sb00000000000000000000000000000001, "Fail logic_gate vector=%0d expexted=%h actual=%h", v000001FAD996D4E0_0, v000001FAD996DA80_0, S<0,vec4,u3> {1 0 0};
T_1.3 ;
    %load/vec4 v000001FAD996D940_0;
    %addi 1, 0, 32;
    %store/vec4 v000001FAD996D940_0, 0, 32;
T_1.2 ; for-loop step statement
    %load/vec4 v000001FAD996D4E0_0;
    %addi 1, 0, 32;
    %store/vec4 v000001FAD996D4E0_0, 0, 32;
    %jmp T_1.0;
T_1.1 ; for-loop exit label
    %load/vec4 v000001FAD996D940_0;
    %cmpi/ne 4, 0, 32;
    %jmp/0xz  T_1.5, 4;
    %vpi_call/w 3 21 "$fatal", 32'sb00000000000000000000000000000001, "Incomplete test" {0 0 0};
T_1.5 ;
    %vpi_call/w 3 22 "$display", "LAB1_PASS logic_gate cases=%0d", v000001FAD996D940_0 {0 0 0};
    %vpi_call/w 3 23 "$finish" {0 0 0};
    %end;
    .thread T_1;
    .scope S_000001FAD9910C90;
T_2 ;
    %delay 100000000, 0;
    %vpi_call/w 3 25 "$fatal", 32'sb00000000000000000000000000000001, "Watchdog" {0 0 0};
    %end;
    .thread T_2;
