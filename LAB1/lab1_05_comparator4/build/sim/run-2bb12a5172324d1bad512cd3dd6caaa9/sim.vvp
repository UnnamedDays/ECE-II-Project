    .scope S_000001A8446E0540;
T_1 ;
    %vpi_call/w 3 14 "$dumpfile", "wave.vcd" {0 0 0};
    %vpi_call/w 3 15 "$dumpvars", 32'sb00000000000000000000000000000000, S_000001A8446E0540 {0 0 0};
    %pushi/vec4 0, 0, 32;
    %store/vec4 v000001A8446EE050_0, 0, 32;
T_1.0 ; Top of for-loop
    %load/vec4 v000001A8446EE050_0;
    %cmpi/s 256, 0, 32;
	  %jmp/0xz T_1.1, 5;
    %load/vec4 v000001A8446EE050_0;
    %pad/s 8;
    %split/vec4 4;
    %store/vec4 v000001A8446EE550_0, 0, 4;
    %store/vec4 v000001A8446ED600_0, 0, 4;
    %load/vec4 v000001A8446EE050_0;
    %pushi/vec4 16, 0, 32;
    %mod/s;
    %load/vec4 v000001A8446EE050_0;
    %pushi/vec4 16, 0, 32;
    %div/s;
    %cmp/s;
    %flag_mov 8, 5;
    %jmp/0 T_1.3, 8;
    %pushi/vec4 4, 0, 4;
    %jmp/1 T_1.4, 8;
T_1.3 ; End of true expr.
    %load/vec4 v000001A8446EE050_0;
    %pushi/vec4 16, 0, 32;
    %div/s;
    %load/vec4 v000001A8446EE050_0;
    %pushi/vec4 16, 0, 32;
    %mod/s;
    %cmp/e;
    %flag_mov 9, 4;
    %jmp/0 T_1.5, 9;
    %pushi/vec4 2, 0, 4;
    %jmp/1 T_1.6, 9;
T_1.5 ; End of true expr.
    %pushi/vec4 1, 0, 4;
    %jmp/0 T_1.6, 9;
 ; End of false expr.
    %blend;
T_1.6;
    %jmp/0 T_1.4, 8;
 ; End of false expr.
    %blend;
T_1.4;
    %pad/s 3;
    %store/vec4 v000001A8446EE410_0, 0, 3;
    %delay 10000, 0;
    %load/vec4 v000001A8446ED830_0;
    %load/vec4 v000001A8446EE410_0;
    %cmp/ne;
    %jmp/0xz  T_1.7, 6;
    %vpi_call/w 3 24 "$fatal", 32'sb00000000000000000000000000000001, "FAIL compare_4 vector=%0d expected=%h actual=%h", v000001A8446EE050_0, v000001A8446EE410_0, v000001A8446ED830_0 {0 0 0};
T_1.7 ;
    %load/vec4 v000001A8446ED6F0_0;
    %addi 1, 0, 32;
    %store/vec4 v000001A8446ED6F0_0, 0, 32;
T_1.2 ; for-loop step statement
    %load/vec4 v000001A8446EE050_0;
    %addi 1, 0, 32;
    %store/vec4 v000001A8446EE050_0, 0, 32;
    %jmp T_1.0;
T_1.1 ; for-loop exit label
    %load/vec4 v000001A8446ED6F0_0;
    %cmpi/ne 256, 0, 32;
    %jmp/0xz  T_1.9, 4;
    %vpi_call/w 3 32 "$fatal", 32'sb00000000000000000000000000000001, "Incomplete test" {0 0 0};
T_1.9 ;
