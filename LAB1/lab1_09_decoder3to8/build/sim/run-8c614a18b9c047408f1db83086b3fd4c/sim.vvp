v000002CC562EF090_0 .net "b", 0 0, v000002CC5634CC30_0;  1 drivers
v000002CC562EF130_0 .net "c", 0 0, v000002CC5634C5F0_0;  1 drivers
v000002CC562FEEE0_0 .net "o", 7 0, L_000002CC5634C910;  alias, 1 drivers
L_000002CC5634CE10 .concat [ 1 1 1 0], v000002CC5634C5F0_0, v000002CC5634CC30_0, v000002CC562FEF80_0;
L_000002CC5634C910 .shift/l 8, L_000002CC5EDD0088, L_000002CC5634CE10;
    .scope S_000002CC562EE620;
T_0 ;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v000002CC5634CAF0_0, 0, 32;
    %end;
    .thread T_0, $init;
    .scope S_000002CC562EE620;
T_1 ;
    %vpi_call/w 3 14 "$dumpfile", "wave.vcd" {0 0 0};
    %vpi_call/w 3 15 "$dumpvars", 32'sb00000000000000000000000000000000, S_000002CC562EE620 {0 0 0};
    %pushi/vec4 0, 0, 32;
    %store/vec4 v000002CC5634C690_0, 0, 32;
T_1.0 ; Top of for-loop
    %load/vec4 v000002CC5634C690_0;
    %cmpi/s 8, 0, 32;
	  %jmp/0xz T_1.1, 5;
    %load/vec4 v000002CC5634C690_0;
    %pad/s 3;
    %split/vec4 1;
    %store/vec4 v000002CC5634C5F0_0, 0, 1;
    %split/vec4 1;
    %store/vec4 v000002CC5634CC30_0, 0, 1;
    %store/vec4 v000002CC562FEF80_0, 0, 1;
    %pushi/vec4 1, 0, 8;
    %load/vec4 v000002CC5634C690_0;
    %ix/vec4 4;
    %shiftl 4;
    %store/vec4 v000002CC5634C0F0_0, 0, 8;
    %delay 10000, 0;
    %load/vec4 v000002CC5634C730_0;
    %load/vec4 v000002CC5634C0F0_0;
    %cmp/ne;
    %jmp/0xz  T_1.3, 6;
    %vpi_call/w 3 23 "$fatal", 32'sb00000000000000000000000000000001, "FAIL decoder3x8 vector=%0d expected=%h actual=%h", v000002CC5634C690_0, v000002CC5634C0F0_0, v000002CC5634C730_0 {0 0 0};
T_1.3 ;
    %load/vec4 v000002CC5634CAF0_0;
    %addi 1, 0, 32;
    %store/vec4 v000002CC5634CAF0_0, 0, 32;
T_1.2 ; for-loop step statement
    %load/vec4 v000002CC5634C690_0;
    %addi 1, 0, 32;
    %store/vec4 v000002CC5634C690_0, 0, 32;
    %jmp T_1.0;
T_1.1 ; for-loop exit label
    %load/vec4 v000002CC5634CAF0_0;
    %cmpi/ne 8, 0, 32;
    %jmp/0xz  T_1.5, 4;
    %vpi_call/w 3 31 "$fatal", 32'sb00000000000000000000000000000001, "Incomplete test" {0 0 0};
T_1.5 ;
    %vpi_call/w 3 33 "$display", "LAB1_PASS decoder3x8 cases=%0d", v000002CC5634CAF0_0 {0 0 0};
    %vpi_call/w 3 34 "$finish" {0 0 0};
    %end;
    .thread T_1;
    .scope S_000002CC562EE620;
T_2 ;
    %delay 100000000, 0;
    %vpi_call/w 3 39 "$fatal", 32'sb00000000000000000000000000000001, "Watchdog" {0 0 0};
