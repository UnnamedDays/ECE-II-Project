 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /INPUT 1 "c";
    .port_info 3 /OUTPUT 8 "o";
L_000002CC5EDD0088 .functor BUFT 1, C4<00000001>, C4<0>, C4<0>, C4<0>;
v000002CC562EEFF0_0 .net/2u *"_ivl_0", 7 0, L_000002CC5EDD0088;  1 drivers
v000002CC562C5120_0 .net *"_ivl_2", 2 0, L_000002CC5634CE10;  1 drivers
